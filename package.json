{
  "name": "huskyconfigure",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "gen:mavlink": "tsx tools/gen-mavlink/gen.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "vite apps/web",
    "build": "vite build apps/web",
    "bridge:sitl": "tsx tools/bridge.ts --tcp 127.0.0.1:5760",
    "gen:metadata": "tsx tools/gen-metadata/convert.ts"
  },
  "devDependencies": {
    "@fontsource/roboto-condensed": "^5.1.0",
    "@fontsource/roboto-mono": "^5.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "fast-xml-parser": "^4.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serialport": "^12.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.0",
    "ws": "^8.18.0"
  }
}
